{
  "name": "assistant-medical-ia",
  "version": "1.0.0",
  "displayName": "Assistant Medical IA",
  "description": "Application mobile intelligente pour l'evaluation des symptomes de sante avec analyse par IA et camera",
  "main": "index.js",
  "scripts": {
    "prepare": "cordova prepare",
    "build:android": "cordova build android",
    "build:ios": "cordova build ios",
    "run:android": "cordova run android",
    "run:ios": "cordova run ios",
    "emulate:android": "cordova emulate android"
  },
  "keywords": [
    "cordova",
    "medical",
    "assistant",
    "IA",
    "symptomes",
    "camera",
    "sante"
  ],
  "author": "Assistant Medical IA",
  "license": "MIT",
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-whitelist": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-file": {},
      "cordova-plugin-dialogs": {}
    }
  },
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-camera": "^7.0.0",
    "cordova-plugin-whitelist": "^1.3.5",
    "cordova-plugin-statusbar": "^4.0.0",
    "cordova-plugin-splashscreen": "^6.0.0",
    "cordova-plugin-file": "^8.0.0",
    "cordova-plugin-dialogs": "^2.0.2"
  }
}